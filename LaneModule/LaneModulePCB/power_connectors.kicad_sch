		(exclude_from_sim no)
		(at 72.644 113.792 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "1bd1218e-2b27-4fdb-9d02-cb067865f4aa")
	)
	(text "J3 IN: 2x5 right-angle pin header (male), right board edge. J2 OUT: 2x5 right-angle socket (female), left board edge.\nBoth on the top side at 0 deg: header pin n then mates socket pin n of the neighbouring board.\nBus, supply and GND pass straight through. Only pin 2 differs: CHAIN_IN / CHAIN_OUT\n(daisy chain for automatic lane position). Pin 1 = DVDD_3V3, pins 4/6/8/10 = GND.\nCaution: plugged 180 deg reversed, pin 1 (3V3) meets pin 10 (GND)."
		(exclude_from_sim no)
		(at 90.17 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "8191e2b8-dd84-484d-887d-499ef8213724")
	)
	(text "Power & lane connectors"
		(exclude_from_sim no)
		(at 122.936 66.802 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "ae35def3-8140-4815-addb-ad1a1f7e55fb")
	)
	(text "C8: 100 uF bulk at the supply input.\nHolds DVDD_3V3 up during the 200 mA\nIRED pulses so they do not sag the chain."
		(exclude_from_sim no)
		(at 129.286 119.126 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "fbd767ad-34aa-4a0c-92f8-fa3b9a0183d8")
	)
