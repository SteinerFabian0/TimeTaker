	(text "VCNL4040 proximity sensor"
		(exclude_from_sim no)
		(at 93.98 76.2 0)
		(effects
			(font
				(size 2.54 2.54)
			)
			(justify left top)
		)
		(uuid "0a150c31-bf6d-4193-aaaa-3774f3be86d8")
	)
	(text "Local I2C bus, sensor only (7-bit address 0x60), max 400 kHz.\n2.2k pull-ups per datasheet. INT is open drain, active low;\noptional in force mode but routed to the MCU."
		(exclude_from_sim no)
		(at 88.9 124.206 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "895ecc24-cef2-4401-9287-c1c132fac93e")
	)
	(text "RC filter R6 / C7: 22 R x 4.7 uF, tau ~100 us, ~7 mV drop at 300 uA.\nKeeps the 200 mA IRED pulses on DVDD_3V3 away from sensor VDD.\nIRED anode (pin 4) taps DVDD_3V3 before the filter. C6 directly at the pin."
		(exclude_from_sim no)
		(at 161.036 124.46 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "be7928ac-60bb-4e37-9570-cad2e34fb0dc")
	)
