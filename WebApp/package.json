{
  "name": "timetaker-webapp",
  "private": true,
  "type": "module",
  "description": "TimeTaker race control web app (Chrome/Edge: Web Serial + Web Bluetooth)",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "app": "node tools/serve.mjs",
    "debug": "node tools/serve.mjs",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.app.json",
    "build": "node tools/build.mjs",
    "serve:dist": "node tools/serve.mjs --dist",
    "deploy": "node tools/deploy.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "preact": "10.29.8",
    "htm": "3.1.1",
    "@preact/signals": "1.3.4",
    "@types/node": "22.18.0"
  }
}
